@model PgrStudentManagement.Web.Modules.PhdApplications.Models.CreatePhdApplicationViewModel

@{
    var hasErrors = !ViewData.ModelState.IsValid;
    ViewData["Title"] = hasErrors
        ? "Error: Create PhD Application"
        : "Create PhD Application";

    var supervisors = ViewBag.Supervisors
        as IReadOnlyList<PgrStudentManagement.Web.Modules.AcademicSupervisors.Contracts.SupervisorSummary>
        ?? Array.Empty<PgrStudentManagement.Web.Modules.AcademicSupervisors.Contracts.SupervisorSummary>();

    bool HasError(string fieldName) =>
        ViewData.ModelState.TryGetValue(fieldName, out var entry) && entry.Errors.Count > 0;

    var firstNameInvalid = HasError(nameof(Model.FirstName));
    var lastNameInvalid = HasError(nameof(Model.LastName));
    var emailInvalid = HasError(nameof(Model.EmailAddress));
    var programmeInvalid = HasError(nameof(Model.ProgrammeCode));
    var modeInvalid = HasError(nameof(Model.ModeOfStudy));
    var startDateInvalid = HasError(nameof(Model.ProposedStartDate));
    var titleInvalid = HasError(nameof(Model.ProposedThesisTitle));
    var summaryInvalid = HasError(nameof(Model.ResearchSummary));
    var fundingInvalid = HasError(nameof(Model.FundingSource));
    var supervisorInvalid = HasError(nameof(Model.ProposedSupervisorStaffNumber));
}

<h1>Create PhD Application</h1>

<div class="form-container">
    @if (hasErrors)
    {
        <div id="error-summary"
             class="alert alert-danger"
             role="alert"
             aria-labelledby="error-summary-title"
             tabindex="-1">
            <h2 id="error-summary-title" class="h5">There is a problem</h2>
            <ul class="mb-0">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>
                            @if (!string.IsNullOrEmpty(entry.Key))
                            {
                                <a href="#@entry.Key" class="alert-link">@error.ErrorMessage</a>
                            }
                            else
                            {
                                @error.ErrorMessage
                            }
                        </li>
                    }
                }
            </ul>
        </div>
        <script>
            document.getElementById('error-summary')?.focus();
        </script>
    }

    <form asp-action="Create" method="post">

        <section class="form-section">
            <h2>1. About you</h2>

            <div class="form-grid-2">
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName"
                           class="form-control @(firstNameInvalid ? "is-invalid" : "")"
                           autocomplete="given-name"
                           spellcheck="false"
                           required
                           maxlength="100"
                           aria-invalid="@(firstNameInvalid ? "true" : "false")"
                           aria-describedby="@(firstNameInvalid ? "FirstName-error" : null)" />
                    <span asp-validation-for="FirstName"
                          id="FirstName-error"
                          class="text-danger fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName"
                           class="form-control @(lastNameInvalid ? "is-invalid" : "")"
                           autocomplete="family-name"
                           spellcheck="false"
                           required
                           maxlength="100"
                           aria-invalid="@(lastNameInvalid ? "true" : "false")"
                           aria-describedby="@(lastNameInvalid ? "LastName-error" : null)" />
                    <span asp-validation-for="LastName"
                          id="LastName-error"
                          class="text-danger fw-semibold"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="EmailAddress" class="form-label"></label>
                <div id="EmailAddress-hint" class="form-text">
                    We will use this email address to send your application reference and updates.
                </div>
                <input asp-for="EmailAddress"
                       type="email"
                       class="form-control input-width-md @(emailInvalid ? "is-invalid" : "")"
                       autocomplete="email"
                       spellcheck="false"
                       required
                       maxlength="255"
                       aria-invalid="@(emailInvalid ? "true" : "false")"
                       aria-describedby="EmailAddress-hint @(emailInvalid ? "EmailAddress-error" : "")" />
                <span asp-validation-for="EmailAddress"
                      id="EmailAddress-error"
                      class="text-danger fw-semibold"></span>
            </div>
        </section>

        <section class="form-section">
            <h2>2. Programme and mode of study</h2>

            <div class="mb-3">
                <label asp-for="ProgrammeCode" class="form-label"></label>
                <select asp-for="ProgrammeCode"
                        class="form-select input-width-md @(programmeInvalid ? "is-invalid" : "")"
                        required
                        aria-invalid="@(programmeInvalid ? "true" : "false")"
                        aria-describedby="@(programmeInvalid ? "ProgrammeCode-error" : null)">
                    <option value="">Select a programme…</option>
                    <option value="PHD-COMP">PhD Computing (PHD-COMP)</option>
                    <option value="PHD-DESIGN">PhD Design (PHD-DESIGN)</option>
                    <option value="MPHIL-COMP">MPhil Computing (MPHIL-COMP)</option>
                </select>
                <span asp-validation-for="ProgrammeCode"
                      id="ProgrammeCode-error"
                      class="text-danger fw-semibold"></span>
            </div>

            <fieldset class="mb-3" id="ModeOfStudy">
                <legend class="form-label">Mode of study</legend>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="ModeOfStudy"
                           id="ModeOfStudy-FullTime"
                           value="Full-time"
                           required />
                    <label class="form-check-label" for="ModeOfStudy-FullTime">
                        Full-time (typically 3 years)
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="ModeOfStudy"
                           id="ModeOfStudy-PartTime"
                           value="Part-time"
                           required />
                    <label class="form-check-label" for="ModeOfStudy-PartTime">
                        Part-time (typically 6 years)
                    </label>
                </div>

                <span asp-validation-for="ModeOfStudy"
                      id="ModeOfStudy-error"
                      class="text-danger fw-semibold"></span>
            </fieldset>

            <div class="mb-3">
                <label asp-for="ProposedStartDate" class="form-label"></label>
                <div id="ProposedStartDate-hint" class="form-text">
                    For example, 01/10/2027. Most cohorts begin in October or January.
                </div>
                <input asp-for="ProposedStartDate"
                       type="date"
                       class="form-control input-width-sm @(startDateInvalid ? "is-invalid" : "")"
                       required
                       aria-invalid="@(startDateInvalid ? "true" : "false")"
                       aria-describedby="ProposedStartDate-hint @(startDateInvalid ? "ProposedStartDate-error" : "")" />
                <span asp-validation-for="ProposedStartDate"
                      id="ProposedStartDate-error"
                      class="text-danger fw-semibold"></span>
            </div>
        </section>

        <section class="form-section">
            <h2>3. Research proposal</h2>

            <div class="mb-3">
                <label asp-for="ProposedThesisTitle" class="form-label"></label>
                <div id="ProposedThesisTitle-hint" class="form-text">
                    Provide a working title for your proposed research project (up to 300 characters).
                </div>
                <input asp-for="ProposedThesisTitle"
                       class="form-control @(titleInvalid ? "is-invalid" : "")"
                       required
                       maxlength="300"
                       aria-invalid="@(titleInvalid ? "true" : "false")"
                       aria-describedby="ProposedThesisTitle-hint @(titleInvalid ? "ProposedThesisTitle-error" : "")" />
                <span asp-validation-for="ProposedThesisTitle"
                      id="ProposedThesisTitle-error"
                      class="text-danger fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ResearchSummary" class="form-label"></label>
                <div id="ResearchSummary-hint" class="form-text">
                    Outline your research question, background context, and proposed methodology in up to 2,000 characters.
                </div>
                <textarea asp-for="ResearchSummary"
                          rows="6"
                          class="form-control @(summaryInvalid ? "is-invalid" : "")"
                          maxlength="2000"
                          data-maxlength="2000"
                          aria-invalid="@(summaryInvalid ? "true" : "false")"
                          aria-describedby="ResearchSummary-hint ResearchSummary-count @(summaryInvalid ? "ResearchSummary-error" : "")"></textarea>
                <div id="ResearchSummary-count"
                     class="form-text"
                     aria-live="polite">
                    You have 2,000 characters remaining
                </div>
                <span asp-validation-for="ResearchSummary"
                      id="ResearchSummary-error"
                      class="text-danger fw-semibold"></span>
            </div>
        </section>

        <section class="form-section">
            <h2>4. Funding and supervision</h2>

            <fieldset class="mb-3" id="FundingSource">
                <legend class="form-label">How will your PhD studies be funded?</legend>

                @foreach (var item in Html.GetEnumSelectList<FundingType>())
                {
                    var radioId = $"FundingSource-{item.Value}";
                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="FundingSource"
                               id="@radioId"
                               value="@item.Value"
                               required
                               checked="@(Model.FundingSource?.ToString() == item.Text || ((int?)Model.FundingSource)?.ToString() == item.Value)" />
                        <label class="form-check-label" for="@radioId">
                            @item.Text
                        </label>
                    </div>
                }

                <span asp-validation-for="FundingSource"
                      id="FundingSource-error"
                      class="text-danger fw-semibold"></span>
            </fieldset>

            <div class="mb-3">
                <label asp-for="ProposedSupervisorStaffNumber" class="form-label"></label>
                <div id="ProposedSupervisor-hint" class="form-text">
                    Only academic staff eligible to act as a Main Supervisor are listed. Leave blank if you have not yet identified a supervisor.
                </div>
                <select asp-for="ProposedSupervisorStaffNumber"
                        class="form-select input-width-md @(supervisorInvalid ? "is-invalid" : "")"
                        aria-invalid="@(supervisorInvalid ? "true" : "false")"
                        aria-describedby="ProposedSupervisor-hint @(supervisorInvalid ? "ProposedSupervisorStaffNumber-error" : "")">
                    <option value="">I have not identified a supervisor yet</option>
                    @foreach (var supervisor in supervisors)
                    {
                        <option value="@supervisor.StaffNumber">
                            @supervisor.DisplayName (@supervisor.StaffNumber)
                        </option>
                    }
                </select>
                <span asp-validation-for="ProposedSupervisorStaffNumber"
                      id="ProposedSupervisorStaffNumber-error"
                      class="text-danger fw-semibold"></span>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Submit application
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>
